/target
**/*.rs.bk

# Exported agent-session archives (personal, never commit)
session_*.zip

# Local test servers and everything they produce (never commit)
/.test-servers/
*.log
*.tmp
*.jar
crash-reports/
logs/
world/
world_nether/
world_the_end/
usercache.json
banned-*.json
ops.json
whitelist.json

# Cached Microsoft sign-in refresh token (a live credential, never commit).
.minerider_msa_cache.json

# Local environment files — the CLI's `--proxy-profile id=PREFIX` flag
# reads proxy host/port/credentials from `{PREFIX}_HOST`/`_PORT`/
# `_USERNAME`/`_PASSWORD` env vars (see docs/lua_wrapper.md
# #proxy-grouping-and-credentials), and a `.env` is the obvious place to
# keep those locally — never commit an actual one. Committed example/
# template files (e.g. `.env.example`) are explicitly kept out of this,
# so adding one later doesn't silently vanish from `git status`.
.env
.env.local
.env.*.local
!.env.example
!.env.*.example

# Local slash-command transcripts exported by the coding agent (never commit;
# narrow pattern so it doesn't blanket-ignore legitimate .txt files).
*-local-command*.txt
